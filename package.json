{
  "name": "kattappa",
  "private": true,
  "version": "0.2.7",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --format=iife --global-name=Kattappa --outfile=dist/bundle.js --jsx=automatic --loader:.css=text",
    "watch": "npm run build -- --watch",
    "dev": "esbuild src/main.tsx --bundle --format=iife --outfile=demo/bundle.js --jsx=automatic --loader:.css=text --servedir=demo --serve=5173 --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
